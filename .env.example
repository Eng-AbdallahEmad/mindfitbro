APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gymweb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CONTACT_PHONE=

LOCATION_TESTING_ENABLED=true
LOCATION_TESTING_COUNTRY_CODE=EG

# --- Paymob payment gateway (see config/services.php, config/payment.php) ---
# Master kill switch. false = checkout shows a maintenance message, no order row created (wired in Batch 5).
PAYMOB_ENABLED=true
# Paymob API base URL — confirm against the real docs before setting (Batch 4).
PAYMOB_BASE_URL=https://accept.paymob.com
# Paymob secret key (server-side auth for API calls). Keep out of version control.
PAYMOB_SECRET_KEY=
# Paymob public key (used client-side by the unified checkout iframe).
PAYMOB_PUBLIC_KEY=
# Paymob HMAC secret used to verify webhook callback signatures.
PAYMOB_HMAC_SECRET=
# Paymob integration ID for the online-card payment method.
PAYMOB_INTEGRATION_ID_CARD=
# Paymob integration ID for mobile wallet payments.
PAYMOB_INTEGRATION_ID_WALLET=
# Paymob integration ID for Apple Pay — leave empty until Paymob enables Apple
# Pay on this merchant account and issues one (business/KYC step, not a code change).
PAYMOB_INTEGRATION_ID_APPLE_PAY=
# Currency Paymob actually charges in. This merchant account only supports EGP.
PAYMOB_CHARGE_CURRENCY=EGP
# Timeout in seconds for outbound HTTP calls to Paymob.
PAYMOB_HTTP_TIMEOUT=30
# TEMPORARY (Batch 6 sandbox capture only): logs the full raw webhook payload (hmac/pan redacted). Leave false otherwise.
PAYMOB_LOG_RAW_WEBHOOK_PAYLOAD=false

# FX markup percent added on top of the base rate when converting to EGP (safety margin).
PAYMENT_FX_MARKUP_PERCENT=0
# How the final EGP charge amount is rounded: none | up_to_nearest_5 | up_to_nearest_10
PAYMENT_FX_ROUNDING=up_to_nearest_5

# FX rate provider used by `php artisan fx:refresh` (scheduled daily): er_api | currency_api
FX_PROVIDER_PRIMARY=er_api
FX_PROVIDER_FALLBACK=currency_api
# Timeout in seconds for outbound HTTP calls when fetching FX rates.
FX_HTTP_TIMEOUT=5
# Below this age (hours) a stored FX rate is used silently.
FX_STALE_AFTER_HOURS=48
# Below this age (hours) a stored FX rate is still used but logs a warning; at or beyond it, treated as expired.
FX_MAX_AGE_HOURS=168
# fx:refresh rejects (and logs CRITICAL) a fetched rate that deviates more than this percent from the stored one.
FX_SANITY_DEVIATION_PERCENT=15
